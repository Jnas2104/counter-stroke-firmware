// Linker Taster = Pfeil links, rechter Taster = Pfeil rechts – die Standardtasten der App.
// Beide Taster zugleich: kurz = Neustart in der App (beide Pfeile), 3 s halten = Wartungsmodus.
// Im Wartungsmodus:
//   linker Taster  = Update-Modus (vorher per USB an den Rechner, dann erscheint das Laufwerk
//                    NICENANO, .uf2 draufziehen; ohne USB startet die Box nach 3 s normal neu)
//   rechter Taster = Bluetooth-Kopplung löschen, damit sich ein anderes Handy verbinden kann
//                    (ZMK lehnt sonst jedes zweite Gerät ab), danach wieder normal
//   beide Taster   = abbrechen, wieder normal
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        beide: beide {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT &kp RIGHT>
                , <&macro_release &kp LEFT &kp RIGHT>
                ;
        };

        entkoppeln: entkoppeln {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&to 0>;
        };
    };

    behaviors {
        beide_lang: beide_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&to>, <&beide>;
        };
    };

    combos {
        compatible = "zmk,combos";
        beide_normal {
            key-positions = <0 1>;
            timeout-ms = <40>; // so lange wartet ein einzelner Druck auf den zweiten Taster
            layers = <0>;
            bindings = <&beide_lang 1 0>;
        };
        beide_wartung {
            key-positions = <0 1>;
            timeout-ms = <40>;
            layers = <1>;
            bindings = <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <&kp LEFT &kp RIGHT>;
        };

        wartung {
            bindings = <&bootloader &entkoppeln>;
        };
    };
};
