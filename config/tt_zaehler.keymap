// Linker Taster = Pfeil links, rechter Taster = Pfeil rechts – die Standardtasten der App.
// Beide Taster zugleich: kurz = Neustart in der App (beide Pfeile), 5 s halten = Bluetooth-Kopplung
// löschen, damit sich ein anderes Handy verbinden kann (ZMK lehnt sonst jedes zweite Gerät ab).
// Beide Taster 3× drücken und beim dritten Mal 3 s halten = Update-Modus: vorher per USB an den
// Rechner, dann erscheint das Laufwerk NICENANO, .uf2 draufziehen. Kein Reset-Taster nötig.
// Ohne USB-Datenverbindung startet der Bootloader nach 3 s von selbst wieder normal.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        beide: beide {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT &kp RIGHT>
                , <&macro_release &kp LEFT &kp RIGHT>
                ;
        };
    };

    behaviors {
        beide_lang: beide_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <5000>;
            bindings = <&bt>, <&beide>;
        };

        update_lang: update_lang {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bootloader>, <&beide>;
        };

        // Der Neustart (kurz beide) kommt dadurch 300 ms später – wartet auf weitere Drücke.
        beide_tanz: beide_tanz {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&beide_lang BT_CLR>, <&beide>, <&update_lang 0 0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        entkoppeln {
            key-positions = <0 1>;
            timeout-ms = <40>; // so lange wartet ein einzelner Druck auf den zweiten Taster
            bindings = <&beide_tanz>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <&kp LEFT &kp RIGHT>;
        };
    };
};
